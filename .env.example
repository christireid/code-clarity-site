# ============================================
# CODE & CLARITY - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env.local for development
# All variables prefixed with NEXT_PUBLIC_ are exposed to the browser

# --------------------------------------------
# RESEND EMAIL SERVICE
# --------------------------------------------
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# Sender email address (must be verified in Resend)
# Format: "Name <email@domain.com>"
RESEND_FROM_EMAIL="Code & Clarity <hello@codeclarity.ai>"

# Email address for internal notifications (new leads, contact forms)
CONTACT_NOTIFY_EMAIL=team@codeclarity.ai

# --------------------------------------------
# RATE LIMITING (Optional)
# --------------------------------------------
# Rate limit window in seconds (default: 3600 = 1 hour)
RATE_LIMIT_WINDOW=3600

# Max requests per form type per window (default: 3 for contact, 5 for waitlist/newsletter)
# RATE_LIMIT_CONTACT=3
# RATE_LIMIT_WAITLIST=5
# RATE_LIMIT_NEWSLETTER=5

# --------------------------------------------
# ANALYTICS (Optional)
# --------------------------------------------
# Vercel Analytics is automatically enabled when deployed to Vercel
# For custom analytics providers, add keys here:

# PostHog (if using instead of Vercel Analytics)
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Google Analytics (optional)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --------------------------------------------
# DATABASE (Optional - for lead storage)
# --------------------------------------------
# Currently using email-only persistence + structured logs
# Uncomment if connecting to Supabase:

# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_ANON_KEY=eyxxxxxxxxxxxx
# SUPABASE_SERVICE_ROLE_KEY=eyxxxxxxxxxxxx

# Or Upstash Redis (for rate limiting at scale):
# UPSTASH_REDIS_REST_URL=https://xxxxxxxxxxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxx

# --------------------------------------------
# FEATURE FLAGS (Optional)
# --------------------------------------------
# Enable/disable email confirmations to users
ENABLE_EMAIL_CONFIRMATION=true

# Enable Slack notifications for new leads
ENABLE_SLACK_NOTIFICATIONS=false
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx

# --------------------------------------------
# SITE CONFIG (Optional)
# --------------------------------------------
# Override site URL for emails/links (auto-detected in most cases)
# NEXT_PUBLIC_SITE_URL=https://codeclarity.ai
